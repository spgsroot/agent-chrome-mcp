{
  "name": "@ethanwilkins/chrome-mcp-server-2026",
  "description": "A Chrome extension that exposes browser control to MCP clients",
  "author": "hangye",
  "private": true,
  "version": "2.8.6",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "postzip": "node scripts/postzip.mjs",
    "zip:firefox": "wxt zip -b firefox",
    "typecheck": "vue-tsc --noEmit",
    "compile": "pnpm run typecheck",
    "postinstall": "node -e \"try{require('child_process').execSync('wxt prepare',{cwd:__dirname,shell:true,stdio:'inherit'})}catch(e){}\"",
    "lint": "npx eslint .",
    "lint:fix": "npx eslint . --fix",
    "format": "npx prettier --write .",
    "format:check": "npx prettier --check .",
    "test": "vitest run",
    "test:action-snapshot-baseline": "vitest run tests/tools/interaction-helper.test.ts --testNamePattern=baseline --reporter=verbose",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ethanwilkins/chrome-mcp-shared-2026": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "date-fns": "^4.1.0",
    "gifenc": "^1.0.3",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.318",
    "@vitejs/plugin-vue": "^6.0.9",
    "@wxt-dev/module-vue": "^1.0.3",
    "dotenv": "^17.4.2",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^26.0.0",
    "typescript": "6.0.2",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.3.11",
    "wxt": "^0.21.4"
  }
}
